# Open edX Platform Environment Configuration
# Copy to .env and fill in secrets before running.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=lms.envs.production
SECRET_KEY=change-me-in-production
EDX_PLATFORM_SETTINGS=production

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_NAME=edxapp
DATABASE_USER=edxapp001
DATABASE_PASSWORD=change-me
DATABASE_HOST=mysql
DATABASE_PORT=3306

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=edxapp

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_SEARCH_CONFIG=[{"host":"elasticsearch","port":9200}]

# ── Memcached / Redis ────────────────────────────────────────────────────────
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── External Services ────────────────────────────────────────────────────────
LMS_BASE=localhost:18000
CMS_BASE=localhost:18010
PREVIEW_LMS_BASE=preview.localhost:18000

# ── AWS / S3 (optional) ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
